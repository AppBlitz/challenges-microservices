---Agregar departamento---

docker exec -it challenges-microservices-db-d-1 mysql -u carlos -pdepartments12345 departments -e "INSERT INTO departments (id, name, description) VALUES (1, 'IT', 'Departamento de Tecnología e Informática');"
---Ver cuales empleados hay---

docker exec -it challenges-microservices-db-e-1 psql -U carlos -d employees -c "SELECT * FROM employee_entity;"

----Realizar prueba de latencia---

$token = (Invoke-RestMethod -Method POST -Uri "http://localhost:8086/auth/login" -ContentType "application/json" -Body '{"email":"admin@empresa.com","password":"admin123"}').token

Invoke-RestMethod -Method POST -Uri "http://localhost:8081/employee/save/" `
  -ContentType "application/json" `
  -Headers @{Authorization="Bearer $token"} `
  -Body '{"id_employee":10,"name_one":"Ana","other_name":"Maria","first_surname":"Gomez","second_surname":"Lopez","telephone":"3001234567","address":"Calle 123","postcode":110111,"email":"ana@empresa.com","city_name":"Bogota","position_name":"Developer","department_id":1}'

for ($i = 1; $i -le 10; $i++) {
  Invoke-RestMethod -Uri "http://localhost:8081/employee/all/" -Headers @{Authorization="Bearer $token"}
  Write-Host "Request $i completado"
}


